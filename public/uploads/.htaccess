# 上传目录：禁止执行脚本，仅允许静态资源
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|phar|pl|py|jsp|asp|aspx|cgi|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|phar|pl|py|jsp|asp|aspx|cgi|sh)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</IfModule>

Options -Indexes
